{
  "name": "@sususgh/gamer-dsh-plugin",
  "version": "1.0.2",
  "description": "Native DeepSeek Harness plugin with automatic desktop QR pairing and Gamer runtime UI",
  "type": "module",
  "license": "Apache-2.0",
  "author": "sususgh",
  "repository": {
    "type": "git",
    "url": "https://github.com/sususgh/Gamer-DSH-Plugin.git"
  },
  "homepage": "https://github.com/sususgh/Gamer-DSH-Plugin",
  "bugs": {
    "url": "https://github.com/sususgh/Gamer-DSH-Plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gamer",
    "game-agent",
    "android-companion"
  ],
  "files": [
    "dsh",
    "desktop-runtime",
    "desktop-ui",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/DSH-INSTALL.zh-CN.md",
    "docs/runtime-protocol-v1.md",
    "locale"
  ],
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check dsh/index.js && node --check dsh/client.js && node --check desktop-runtime/pairing.js && node --check desktop-runtime/server.js && node --check desktop-ui/app.js && node --check desktop-runtime/engine/safety-gate.js",
    "desktop": "node desktop-runtime/server.js",
    "start:desktop": "node desktop-runtime/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
